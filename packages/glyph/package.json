{
  "name": "@pmndrs/glyph",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Justin Walsh (https://github.com/thejustinwalsh)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/glyph.git",
    "directory": "packages/glyph"
  },
  "bin": {
    "glyph": "./bin/glyph.js"
  },
  "files": [
    "LICENSE",
    "bin",
    "dist",
    "src",
    "!dist/.tsbuildinfo",
    "!dist/internal/raster-baker-profile.d.ts",
    "!dist/internal/raster-baker-profile.js"
  ],
  "type": "module",
  "sideEffects": [
    "./src/raster/bitmap.ts",
    "./src/raster/msdf.ts",
    "./src/raster/slug.ts",
    "./dist/raster/bitmap.js",
    "./dist/raster/msdf.js",
    "./dist/raster/slug.js",
    "./dist/internal/bitmap-*.js",
    "./dist/internal/msdf-*.js",
    "./dist/internal/slug-*.js"
  ],
  "exports": {
    ".": {
      "types": {
        "source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./tsl": {
      "types": {
        "source": "./src/tsl.ts",
        "default": "./dist/tsl.d.ts"
      },
      "source": "./src/tsl.ts",
      "import": "./dist/tsl.js"
    },
    "./tsl/bitmap": {
      "types": {
        "source": "./src/tsl/bitmap-shader.ts",
        "default": "./dist/tsl/bitmap-shader.d.ts"
      },
      "source": "./src/tsl/bitmap-shader.ts",
      "import": "./dist/tsl/bitmap-shader.js"
