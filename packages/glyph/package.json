      "types": {
        "source": "./src/react/msdf.ts",
        "default": "./dist/react/msdf.d.ts"
      },
      "source": "./src/react/msdf.ts",
      "import": "./dist/react/msdf.js"
    },
    "./react/slug": {
      "types": {
        "source": "./src/react/slug.ts",
        "default": "./dist/react/slug.d.ts"
      },
      "source": "./src/react/slug.ts",
      "import": "./dist/react/slug.js"
    },
    "./react/*": {
      "types": {
        "source": "./src/react/*.ts",
        "default": "./dist/react/*.d.ts"
      },
      "source": "./src/react/*.ts",
      "import": "./dist/react/*.js"
