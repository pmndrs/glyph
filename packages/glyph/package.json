    "./generated/*": null,
    "./font-baker/*": null,
    "./text-shaper.wasm": "./dist/text-shaper.wasm",
    "./bitmap-baker.wasm": "./dist/bitmap-baker.wasm",
    "./mtsdf-baker.wasm": "./dist/mtsdf-baker.wasm",
    "./slug-baker.wasm": "./dist/slug-baker.wasm",
    "./font-baker.wasm": "./dist/font-baker.wasm",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ./scripts/unicode.mts check-data && node ./scripts/build.mjs",
    "test": "node ./scripts/test.mts",
    "check": "node ./scripts/check.mts"
  },
  "dependencies": {
    "ajv": "6.15.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "ktx-parse": "1.1.0",
    "suspend-react": "0.1.3",
    "unicode-segmenter": "0.15.0"
  },
  "devDependencies": {
    "@cto.af/linebreak": "4.0.3",
