    "three": ">=0.185.1",
    "typegpu": ">=0.12.3 <0.13"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "typegpu": {
      "optional": true
    }
  },
  "pmndrs": {
    "glyph": {
      "bitmap": "./bakers/bitmap",
      "msdf": "./bakers/msdf",
