{
  "name": "@pmndrs/glyph",
  "version": "0.1.0",
  "description": "A typography engine for web graphics.",
  "keywords": [
    "text-rendering",
    "threejs",
    "typegpu",
    "typography",
    "webgpu"
  ],
  "license": "MIT",
  "author": "Justin Walsh (https://github.com/thejustinwalsh)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/glyph.git",
    "directory": "packages/glyph"
  },
  "bin": {
    "glyph": "./bin/glyph.js"
  },
  "files": [
    "LICENSE",
    "bin",
    "dist",
    "src",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "!dist/internal/raster-baker-profile.d.ts",
    "!dist/internal/raster-baker-profile.js"
  ],
  "type": "module",
  "sideEffects": [
    "./src/raster/bitmap.ts",
    "./src/raster/msdf.ts",
    "./src/raster/slug.ts",
    "./dist/raster/bitmap.js",
    "./dist/raster/msdf.js",
    "./dist/raster/slug.js",
    "./dist/internal/bitmap-*.js",
    "./dist/internal/msdf-*.js",
    "./dist/internal/slug-*.js"
  ],
  "exports": {
    ".": {
      "types": {
        "source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./shaders/tsl": {
      "types": {
        "source": "./src/shaders/tsl/index.ts",
        "default": "./dist/shaders/tsl/index.d.ts"
      },
      "source": "./src/shaders/tsl/index.ts",
      "import": "./dist/shaders/tsl/index.js"
    },
    "./shaders/tsl/internal/*": null,
    "./shaders/tsl/slug/internal/*": null,
    "./shaders/typegpu": {
      "types": {
        "source": "./src/shaders/typegpu/index.ts",
        "default": "./dist/shaders/typegpu/index.d.ts"
      },
      "source": "./src/shaders/typegpu/index.ts",
      "import": "./dist/shaders/typegpu/index.js"
    },
    "./shaders/typegpu/internal/*": null,
    "./shaders/typegpu/slug/internal/*": null,
    "./three": {
      "types": {
        "source": "./src/three.ts",
        "default": "./dist/three.d.ts"
      },
      "source": "./src/three.ts",
      "import": "./dist/three.js"
    },
    "./three/internal/*": null,
    "./three/handle": null,
    "./three/schema": null,
    "./three/plan-program-registry": null,
    "./three/codec": null,
    "./three/command-buffer-renderer": null,
    "./three/decorations": null,
    "./three/detached-object": null,
    "./three/engine-plan-target": null,
    "./three/frame-error": null,
    "./three/glyph-measurement": null,
    "./three/glyphs": null,
    "./three/font-loader": null,
    "./three/loader": null,
    "./three/renderer-resources": null,
    "./three/text": null,
    "./three/transform-synchronizer": null,
    "./react": {
      "types": {
        "source": "./src/react/index.ts",
        "default": "./dist/react/index.d.ts"
      },
      "source": "./src/react/index.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": {
        "source": "./src/vue.ts",
        "default": "./dist/vue.d.ts"
      },
      "source": "./src/vue.ts",
      "import": "./dist/vue.js"
    },
    "./vue/internal/*": null,
    "./vue/*": {
      "types": {
        "source": "./src/vue/*.ts",
        "default": "./dist/vue/*.d.ts"
      },
      "source": "./src/vue/*.ts",
      "import": "./dist/vue/*.js"
    },
    "./raster/internal/*": null,
    "./config/font-library": null,
    "./config/raster-host": null,
    "./config/text-property": null,
    "./bakers/bitmap": {
      "types": {
        "source": "./src/bakers/bitmap.ts",
        "default": "./dist/bakers/bitmap.d.ts"
      },
      "source": "./src/bakers/bitmap.ts",
      "import": "./dist/bakers/bitmap.js"
    },
    "./bakers/msdf": {
      "types": {
        "source": "./src/bakers/msdf.ts",
        "default": "./dist/bakers/msdf.d.ts"
      },
      "source": "./src/bakers/msdf.ts",
      "import": "./dist/bakers/msdf.js"
    },
    "./bakers/slug": {
      "types": {
        "source": "./src/bakers/slug.ts",
        "default": "./dist/bakers/slug.d.ts"
      },
      "source": "./src/bakers/slug.ts",
      "import": "./dist/bakers/slug.js"
    },
    "./baker": {
      "types": {
        "source": "./src/bake.ts",
        "default": "./dist/bake.d.ts"
      },
      "source": "./src/bake.ts",
      "import": "./dist/bake.js"
    },
    "./bake": {
      "types": {
        "source": "./src/node/bake.ts",
        "default": "./dist/node/bake.d.ts"
      },
      "source": "./src/node/bake.ts",
      "import": "./dist/node/bake.js"
    },
    "./runtime-bake": {
      "types": {
        "source": "./src/runtime-bake.ts",
        "default": "./dist/runtime-bake.d.ts"
      },
      "source": "./src/runtime-bake.ts",
      "import": "./dist/runtime-bake.js"
    },
    "./loader": null,
    "./internal/*": null,
    "./generated/*": null,
    "./font-baker/*": null,
    "./text-shaper.wasm": "./dist/text-shaper.wasm",
    "./text-shaper.wasm.gz": "./dist/text-shaper.wasm.gz",
    "./bitmap-baker.wasm": "./dist/bitmap-baker.wasm",
    "./mtsdf-baker.wasm": "./dist/mtsdf-baker.wasm",
    "./slug-baker.wasm": "./dist/slug-baker.wasm",
    "./font-baker.wasm": "./dist/font-baker.wasm",
    "./package.json": "./package.json",
    "./typegpu": {
      "types": {
        "source": "./src/typegpu.ts",
        "default": "./dist/typegpu.d.ts"
      },
      "source": "./src/typegpu.ts",
      "import": "./dist/typegpu.js"
    },
    "./three/typegpu": {
      "types": {
        "source": "./src/three/typegpu.ts",
        "default": "./dist/three/typegpu.d.ts"
      },
      "source": "./src/three/typegpu.ts",
      "import": "./dist/three/typegpu.js"
    },
    "./three/typegpu/internal/*": null,
    "./core": {
      "types": {
        "source": "./src/core.ts",
        "default": "./dist/core.d.ts"
      },
      "source": "./src/core.ts",
      "import": "./dist/core.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ./scripts/unicode.mts check-data && node ./scripts/build.mjs",
    "test": "node ./scripts/test.mts",
    "check": "node ./scripts/check.mts"
  },
  "dependencies": {
    "ajv": "6.15.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "ktx-parse": "1.1.0",
    "oxc-parser": "0.150.0",
    "oxc-resolver": "11.24.2",
    "oxc-walker": "1.1.1",
    "suspend-react": "0.1.3",
    "unicode-segmenter": "0.15.0"
  },
  "devDependencies": {
    "@cto.af/linebreak": "4.0.3",
    "@react-three/fiber": "catalog:renderer",
    "@react-three/test-renderer": "catalog:renderer",
    "@tresjs/core": "5.8.3",
    "@typegpu/gl": "catalog:renderer",
    "@typegpu/three": "catalog:renderer",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/three": "0.185.4",
    "@unicode/unicode-17.0.0": "1.6.17",
    "@webgpu/types": "0.1.71",
    "binaryen": "129.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "happy-dom": "20.14.0",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "react": "catalog:renderer",
    "three": "catalog:renderer",
    "tsdown": "0.22.14",
    "typegpu": "catalog:renderer",
    "typescript": "7.0.2",
    "unicode-property-value-aliases": "3.9.0",
    "unplugin-typegpu": "0.12.2",
    "vite": "8.1.5",
    "vue": "3.5.42"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.7.0 <10 || >=10.0.0-alpha.4 <11",
    "@tresjs/core": ">=5.8.3 <6",
    "@typegpu/gl": ">=0.12.4 <0.13",
    "@typegpu/three": ">=0.12.1 <0.13",
    "react": ">=19.0.0 <19.3",
    "three": ">=0.185.0",
    "typegpu": ">=0.12.5 <0.13",
    "vue": ">=3.5 <4"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "@tresjs/core": {
      "optional": true
    },
    "@typegpu/gl": {
      "optional": true
    },
    "@typegpu/three": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "typegpu": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "pmndrs": {
    "glyph": {
      "bitmap": "./bakers/bitmap",
      "msdf": "./bakers/msdf",
      "slug": "./bakers/slug"
    }
  }
}
