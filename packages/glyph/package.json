    "./raster/bitmap": {
      "types": {
        "source": "./src/raster/bitmap.ts",
        "default": "./dist/raster/bitmap.d.ts"
      },
      "source": "./src/raster/bitmap.ts",
      "import": "./dist/raster/bitmap.js"
    },
    "./raster/msdf": {
      "types": {
        "source": "./src/raster/msdf.ts",
        "default": "./dist/raster/msdf.d.ts"
      },
      "source": "./src/raster/msdf.ts",
      "import": "./dist/raster/msdf.js"
    },
    "./raster/slug": {
      "types": {
        "source": "./src/raster/slug.ts",
        "default": "./dist/raster/slug.d.ts"
      },
      "source": "./src/raster/slug.ts",
      "import": "./dist/raster/slug.js"
    },
    "./raster/internal/*": null,
    "./raster/*": {
      "types": {
        "source": "./src/raster/*.ts",
        "default": "./dist/raster/*.d.ts"
      },
      "source": "./src/raster/*.ts",
      "import": "./dist/raster/*.js"
    },
    "./config/*": {
