    "@react-three/test-renderer": "10.0.0-alpha.3",
    "@typegpu/gl": "0.12.4",
    "@typegpu/three": "^0.12.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/three": "0.185.4",
    "@unicode/unicode-17.0.0": "1.6.17",
    "@webgpu/types": "0.1.71",
    "binaryen": "129.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "react": "19.2.8",
    "three": "0.185.1",
    "tsdown": "0.22.14",
    "typegpu": "0.12.5",
    "typescript": "7.0.2",
    "unicode-property-value-aliases": "3.9.0",
    "unplugin-typegpu": "0.12.2",
    "vite": "8.1.5"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=10.0.0-alpha.3 <11",
    "@typegpu/gl": ">=0.12.4 <0.13",
    "@typegpu/three": ">=0.12.0 <0.13",
    "react": ">=19.2 <19.3",
    "three": ">=0.185.1",
    "typegpu": ">=0.12.5 <0.13"
  },
  "peerDependenciesMeta": {
