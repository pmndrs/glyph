{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "PMNDRS_font glTF Document Extension",
  "type": "object",
  "allOf": [
    {
      "$ref": "glTFProperty.schema.json"
    }
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "shaping": {
      "type": "object",
      "allOf": [
        {
          "$ref": "glTFProperty.schema.json"
        }
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "opentype-sfnt-harfrust-v0"
          ]
        },
        "bufferView": {
          "type": "integer",
          "minimum": 0
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "fontFunctions": {
          "type": "object",
          "properties": {
            "glyphExtentsBufferView": {
              "type": "integer",
              "minimum": 0
            },
            "glyphExtentsStride": {
              "type": "integer",
              "enum": [
                8
              ]
            },
            "glyphExtentsAvailabilityBufferView": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "glyphExtentsBufferView",
            "glyphExtentsStride",
            "glyphExtentsAvailabilityBufferView"
          ]
        }
      },
      "required": [
        "format",
        "bufferView",
        "fingerprint",
        "fontFunctions"
      ]
    },
    "metrics": {
      "type": "object",
      "allOf": [
        {
          "$ref": "glTFProperty.schema.json"
        }
      ],
      "properties": {
        "glyphCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "glyphIdWidth": {
          "type": "integer",
          "enum": [
            16
          ]
        },
        "unitsPerEm": {
          "type": "integer",
          "minimum": 16,
          "maximum": 16384
        },
        "ascender": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "descender": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "lineGap": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "underlinePosition": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "underlineThickness": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "strikeoutPosition": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "strikeoutSize": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "required": [
        "glyphCount",
        "glyphIdWidth",
        "unitsPerEm",
        "ascender",
        "descender",
        "lineGap",
        "underlinePosition",
        "underlineThickness",
        "strikeoutPosition",
        "strikeoutSize"
      ]
    },
    "provenance": {
      "type": "object",
      "allOf": [
        {
          "$ref": "glTFProperty.schema.json"
        }
      ],
      "properties": {
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "fontFaceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bakerVersion": {
          "type": "string",
          "minLength": 1
        },
        "harfrustVersion": {
          "type": "string",
          "minLength": 1
        },
        "harfbuzzReferenceVersion": {
          "type": "string",
          "minLength": 1
        },
        "unicodeVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        }
      },
      "required": [
        "sourceFingerprint",
        "fontFaceIndex",
        "bakerVersion",
        "harfrustVersion",
        "harfbuzzReferenceVersion",
        "unicodeVersion"
      ]
    },
    "outlines": {
      "description": "Optional glyph outlines, baked on request: the face's own glyf and loca tables, or its CFF table, unchanged in an SFNT beside head and maxp. A consumer decodes one glyph at a time.",
      "type": "object",
      "allOf": [
        {
          "$ref": "glTFProperty.schema.json"
        }
      ],
      "properties": {
        "bufferView": {
          "description": "The outline SFNT: head, maxp, and either glyf with loca or CFF.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "bufferView"
      ]
    },
    "layoutFeatures": {
      "description": "Optional. The source font's OpenType layout features this bake did not keep (`glyph bake --layout-features`). A runtime refuses text that enables one of them; a tag the source never had is not listed. Absent when the bake dropped none, and in artifacts written before it existed.",
      "type": "object",
      "allOf": [
        {
          "$ref": "glTFProperty.schema.json"
        }
      ],
      "properties": {
        "dropped": {
          "description": "Dropped feature tags, sorted, without duplicates.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[!-~][ -~]{3}$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "family": {
          "description": "The source face's family name, used to name the font in messages.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dropped"
      ]
    },
    "rasters": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "glTFProperty.schema.json"
          }
        ],
        "properties": {
          "rasterKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*$"
          },
          "extension": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Za-z0-9]+)+$"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "embedded"
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "external"
                    ]
                  },
                  "uri": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "rasterKey",
          "kind",
          "extension",
          "version",
          "source"
        ]
      }
    }
  },
  "required": [
    "version",
    "shaping",
    "metrics",
    "provenance",
    "rasters"
  ],
  "dependencies": {
    "outlines": {
      "properties": {
        "version": {
          "enum": [
            1
          ]
        }
      }
    }
  }
}
