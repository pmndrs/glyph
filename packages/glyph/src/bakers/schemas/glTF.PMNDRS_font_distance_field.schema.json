{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "PMNDRS_font_distance_field glTF Document Extension",
  "type": "object",
  "allOf": [{ "$ref": "glTFProperty.schema.json" }],
  "properties": {
    "version": { "type": "integer", "enum": [0] },
    "rasterKey": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "shapingFingerprint": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "glyphCount": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "glyphIdWidth": { "type": "integer", "enum": [16] },
    "coverage": { "$ref": "#/definitions/rasterCoverage" },
    "coverageBufferView": { "type": "integer", "minimum": 0 },
    "encoding": { "type": "string", "enum": ["mtsdf"] },
    "emSize": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "pixelRange": { "type": "number", "exclusiveMinimum": true, "minimum": 0 },
    "planeUnitsPerEm": { "type": "integer", "minimum": 1, "maximum": 32767 },
    "recordBufferView": { "type": "integer", "minimum": 0 },
    "recordStride": { "type": "integer", "enum": [20] },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65535,
      "items": {
        "allOf": [
          { "$ref": "../../schema/textureResource.PMNDRS_font.schema.json" },
          {
            "properties": {
              "colorSpace": { "enum": ["linear"] },
              "variants": {
                "items": {
                  "properties": {
                    "gpuFormat": { "enum": ["rgba8unorm"] },
                    "quality": { "enum": ["lossless"] }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "rasterKey",
    "shapingFingerprint",
    "glyphCount",
    "glyphIdWidth",
    "encoding",
    "emSize",
    "pixelRange",
    "planeUnitsPerEm",
    "recordBufferView",
    "recordStride",
    "pages"
  ],
  "definitions": {
    "rasterCoverage": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "unicodeRanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "integer", "minimum": 0, "maximum": 1114111 },
              "end": { "type": "integer", "minimum": 0, "maximum": 1114111 }
            },
            "required": ["start", "end"],
            "additionalProperties": false
          }
        },
        "text": { "type": "string", "minLength": 1 },
        "glyphIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65535,
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
