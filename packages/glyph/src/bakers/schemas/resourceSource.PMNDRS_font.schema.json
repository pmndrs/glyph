{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "PMNDRS font resource source",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["bufferView"] },
        "bufferView": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "bufferView"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["external"] },
        "uri": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "artifactFingerprint": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      },
      "required": ["type", "uri", "byteLength", "artifactFingerprint"],
      "additionalProperties": false
    }
  ]
}
