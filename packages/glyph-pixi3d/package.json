{
  "name": "@pmndrs/glyph-pixi3d",
  "version": "0.1.0",
  "description": "PixiJS 3D renderer for Glyph text: Bitmap, MSDF and Slug on WebGPU and WebGL2.",
  "keywords": [
    "pixi3d",
    "pixijs",
    "text-rendering",
    "typography",
    "webgpu"
  ],
  "license": "MIT",
  "author": "Justin Walsh (https://github.com/thejustinwalsh)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/glyph.git",
    "directory": "packages/glyph-pixi3d"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "check": "pnpm test && tsc -p tsconfig.json --noEmit && oxlint --deny-warnings . && oxfmt --check package.json src scripts tests tsconfig.json tsconfig.build.json README.md"
  },
  "dependencies": {
    "@pmndrs/glyph": "workspace:^"
  },
  "devDependencies": {
    "@pixi/3d": "catalog:pixi3d",
    "@typegpu/gl": "catalog:renderer",
    "@types/node": "24.13.3",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "pixi.js": "catalog:pixi3d",
    "typegpu": "catalog:renderer",
    "typescript": "7.0.2",
    "unplugin-typegpu": "0.12.2"
  },
  "peerDependencies": {
    "@pixi/3d": ">=0.1.0 <0.2",
    "pixi.js": ">=8.23.0 <9"
  }
}
