{
  "name": "@pmndrs/glyph-example-raster",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Justin Walsh (https://github.com/thejustinwalsh)",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/register.ts",
    "./dist/index.js",
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "types": {
        "source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./baker": {
      "types": {
        "source": "./src/baker.ts",
        "default": "./dist/baker.d.ts"
      },
      "source": "./src/baker.ts",
      "import": "./dist/baker.js"
    },
    "./typegpu": {
      "types": {
        "source": "./src/typegpu.ts",
        "default": "./dist/typegpu.d.ts"
      },
      "source": "./src/typegpu.ts",
      "import": "./dist/typegpu.js"
    },
    "./tsl": {
      "types": {
        "source": "./src/tsl.ts",
        "default": "./dist/tsl.d.ts"
      },
      "source": "./src/tsl.ts",
      "import": "./dist/tsl.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test:bundle": "node ./scripts/bundle-registration-smoke.mjs",
    "test": "pnpm build && pnpm test:bundle && vitest run",
    "check": "pnpm test && tsc -p tsconfig.json --noEmit && oxlint --deny-warnings . && oxfmt --check package.json src tests tsconfig.json tsconfig.build.json"
  },
  "dependencies": {
    "@pmndrs/glyph": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "three": "0.185.1",
    "typegpu": "0.12.3",
    "unplugin-typegpu": "0.12.2",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "three": ">=0.185.1 <0.186",
    "typegpu": ">=0.12.3 <0.13"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "typegpu": {
      "optional": true
    }
  },
  "pmndrs": {
    "glyph": {
      "glyphExample": "./baker"
    }
  }
}
