{
  "name": "@pmndrs/glyph-example-renderer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Justin Walsh (https://github.com/thejustinwalsh)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm build && vitest run",
    "check": "pnpm test && tsc -p tsconfig.json --noEmit && oxlint --deny-warnings . && oxfmt --check package.json src tests tsconfig.json tsconfig.build.json"
  },
  "dependencies": {
    "@pmndrs/glyph": "workspace:*",
    "@pmndrs/glyph-example-raster": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "vitest": "4.1.0"
  }
}
