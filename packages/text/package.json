{
  "name": "@pmndrs/text",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "pmndrs-text-bake": "./dist/node/cli.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./raster/bitmap": {
      "types": "./dist/raster/bitmap.d.ts",
      "import": "./dist/raster/bitmap.js"
    },
    "./raster/msdf": {
      "types": "./dist/raster/msdf.d.ts",
      "import": "./dist/raster/msdf.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./bakers/bitmap": {
      "types": "./dist/bakers/bitmap.d.ts",
      "import": "./dist/bakers/bitmap.js"
    },
    "./bakers/bitmap/validate": {
      "types": "./dist/bakers/bitmap-validator.d.ts",
      "import": "./dist/bakers/bitmap-validator.js"
    },
    "./bakers/msdf": {
      "types": "./dist/bakers/msdf.d.ts",
      "import": "./dist/bakers/msdf.js"
    },
    "./bakers/msdf/validate": {
      "types": "./dist/bakers/msdf-validator.d.ts",
      "import": "./dist/bakers/msdf-validator.js"
    },
    "./bake": {
      "types": "./dist/node/bake.d.ts",
      "import": "./dist/node/bake.js"
    },
    "./runtime-bake": {
      "types": "./dist/runtime-bake.d.ts",
      "import": "./dist/runtime-bake.js"
    },
    "./text-shaper.wasm": "./dist/text_shaper.wasm",
    "./shaper-abi.json": "./dist/text-shaper-abi-v0.json",
    "./bitmap-baker.wasm": "./dist/bitmap_baker.wasm",
    "./bitmap-abi.json": "./dist/bitmap-baker-abi-v0.json",
    "./mtsdf-baker.wasm": "./dist/mtsdf_baker.wasm",
    "./mtsdf-abi.json": "./dist/mtsdf-baker-abi-v0.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm check:unicode-data && node ./scripts/build.mjs",
    "build:typescript": "tsc -p tsconfig.build.json",
    "build:bitmap-rust": "cargo build --manifest-path rust/bitmap-baker/Cargo.toml --target wasm32-unknown-unknown --release --locked --no-default-features",
    "build:mtsdf-rust": "cargo build --manifest-path rust/mtsdf-baker/Cargo.toml --target wasm32-unknown-unknown --release --locked --no-default-features --features artifact-baker",
    "build:mtsdf-admission": "cargo build --manifest-path rust/mtsdf-admission/Cargo.toml --target wasm32-unknown-unknown --release --locked",
    "generate:mtsdf-abi": "cargo run --manifest-path rust/mtsdf-baker/Cargo.toml --bin generate-mtsdf-abi --locked --quiet",
    "test:mtsdf-core-wasm": "node ./scripts/test-mtsdf-core-wasm.mjs",
    "generate:bitmap-abi": "cargo run --manifest-path rust/bitmap-baker/Cargo.toml --bin generate-bitmap-abi --locked --quiet",
    "measure:mtsdf-admission": "node ./scripts/measure-mtsdf-admission.mjs",
    "measure:mtsdf-generator": "pnpm build && node ./scripts/measure-mtsdf-generator.mjs",
    "measure:mtsdf-simd": "pnpm build && node ./scripts/measure-mtsdf-simd.mjs",
    "check:mtsdf-admission": "node ./scripts/measure-mtsdf-admission.mjs --check",
    "check:mtsdf-simd": "pnpm build && node ./scripts/measure-mtsdf-simd.mjs --check",
    "provision:mtsdf-oracle": "node ./scripts/provision-msdfgen-oracle.mjs",
    "generate:mtsdf-oracle": "node ./scripts/generate-mtsdf-oracle-evidence.mjs",
    "check:mtsdf-oracle": "node ./scripts/generate-mtsdf-oracle-evidence.mjs --check",
    "generate:unicode-data": "node ./scripts/generate-unicode-script-data.mjs && node ./scripts/generate-unicode-bidi-data.mjs",
    "check:unicode-data": "node ./scripts/generate-unicode-script-data.mjs --check && node ./scripts/generate-unicode-bidi-data.mjs --check",
    "sync:unicode-tests": "node ./scripts/sync-unicode-test-data.mjs",
    "check:unicode-tests": "node ./scripts/sync-unicode-test-data.mjs --check",
    "generate:bitmap-fixture": "pnpm --filter @pmndrs/text-font-baker build && pnpm build && node ./scripts/generate-bitmap-fixture.mjs",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm test:types && pnpm test:unit && pnpm test:integration && pnpm test:fuzz-smoke",
    "test:unit": "cargo test --manifest-path rust/bitmap-baker/Cargo.toml --lib --locked && cargo test --manifest-path rust/shaper/Cargo.toml --lib --locked && cargo test --manifest-path rust/mtsdf-core/Cargo.toml --lib --locked && cargo test --manifest-path rust/mtsdf-baker/Cargo.toml --lib --locked && cargo test --manifest-path rust/mtsdf-admission/Cargo.toml --lib --locked && pnpm test:mtsdf-core-wasm && pnpm check:mtsdf-admission && pnpm check:mtsdf-simd && pnpm check:mtsdf-oracle",
    "test:integration": "pnpm check:unicode-tests && cargo test --manifest-path rust/bitmap-baker/Cargo.toml --tests --locked && cargo test --manifest-path rust/shaper/Cargo.toml --tests --locked && node --test tests/package/*.test.mjs tests/integration/*.test.mjs",
    "test:fuzz-smoke": "node --test tests/fuzz/*.test.mjs",
    "test:types": "tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "@cto.af/linebreak": "4.0.3",
    "@pmndrs/text-font-baker": "workspace:*",
    "ktx-parse": "1.1.0",
    "typescript": "7.0.2",
    "unicode-segmenter": "0.15.0"
  },
  "devDependencies": {
    "@react-three/fiber": "10.0.0-alpha.2",
    "@react-three/test-renderer": "9.1.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/three": "0.185.1",
    "@unicode/unicode-17.0.0": "1.6.17",
    "binaryen": "129.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "react": "19.2.8",
    "three": "0.185.1",
    "unicode-property-value-aliases": "3.9.0"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=10.0.0-alpha.2 <11",
    "react": ">=19 <19.3",
    "three": ">=0.185.1"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "pmndrs": {
    "text": {
      "bitmap": "./bakers/bitmap",
      "msdf": "./bakers/msdf"
    }
  }
}
