{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "PMNDRS_font_slug glTF Document Extension",
  "type": "object",
  "allOf": [{ "$ref": "glTFProperty.schema.json" }],
  "properties": {
    "version": { "type": "integer", "enum": [0] },
    "presentationId": { "type": "string", "minLength": 1 },
    "shapingHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "glyphCount": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "glyphIdWidth": { "type": "integer", "enum": [16] },
    "planeUnitsPerEm": { "type": "integer", "minimum": 1, "maximum": 32767 },
    "recordBufferView": { "type": "integer", "minimum": 0 },
    "recordStride": { "type": "integer", "enum": [40] },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65535,
      "items": {
        "type": "object",
        "properties": {
          "curveWidth": { "type": "integer", "minimum": 2, "maximum": 65535 },
          "curveHeight": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "curve": { "$ref": "../../schema/textureResource.PMNDRS_font.schema.json" },
          "headerCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "headerBufferView": { "type": "integer", "minimum": 0 },
          "referenceCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "referenceBufferView": { "type": "integer", "minimum": 0 }
        },
        "required": ["curveWidth", "curveHeight", "curve", "headerCount", "headerBufferView", "referenceCount", "referenceBufferView"]
      }
    }
  },
  "required": ["version", "presentationId", "shapingHash", "glyphCount", "glyphIdWidth", "planeUnitsPerEm", "recordBufferView", "recordStride", "pages"]
}
