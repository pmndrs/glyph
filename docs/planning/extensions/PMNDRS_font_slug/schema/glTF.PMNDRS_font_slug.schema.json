{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "PMNDRS_font_slug glTF Document Extension",
  "type": "object",
  "allOf": [{ "$ref": "glTFProperty.schema.json" }],
  "properties": {
    "version": { "type": "integer", "enum": [0] },
    "rasterKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "shapingHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "glyphCount": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "glyphIdWidth": { "type": "integer", "enum": [16] },
    "planeUnitsPerEm": { "type": "integer", "minimum": 1, "maximum": 32767 },
    "recordBufferView": { "type": "integer", "minimum": 0 },
    "recordStride": { "type": "integer", "enum": [40] },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65535,
      "items": {
        "type": "object",
        "properties": {
          "curve": {
            "allOf": [
              { "$ref": "../../schema/textureResource.PMNDRS_font.schema.json" },
              {
                "properties": {
                  "colorSpace": { "enum": ["linear"] },
                  "variants": {
                    "items": {
                      "properties": {
                        "gpuFormat": { "enum": ["rgba16float"] },
                        "quality": { "enum": ["lossless"] }
                      }
                    }
                  }
                }
              }
            ]
          },
          "headerCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "headerWidth": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "headerHeight": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "headerResource": { "$ref": "../../schema/binaryResource.PMNDRS_font.schema.json" },
          "referenceCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "referenceWidth": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "referenceHeight": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "referenceResource": { "$ref": "../../schema/binaryResource.PMNDRS_font.schema.json" }
        },
        "required": [
          "curve",
          "headerCount",
          "headerWidth",
          "headerHeight",
          "headerResource",
          "referenceCount",
          "referenceWidth",
          "referenceHeight",
          "referenceResource"
        ]
      }
    }
  },
  "required": [
    "version",
    "rasterKey",
    "shapingHash",
    "glyphCount",
    "glyphIdWidth",
    "planeUnitsPerEm",
    "recordBufferView",
    "recordStride",
    "pages"
  ]
}
