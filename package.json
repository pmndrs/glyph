{
  "name": "pmndrs-text-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check",
    "docs:check": "ruby .agents/skills/open-knowledge-format/scripts/validate_okf.rb docs --workspace-root .",
    "format:check": "pnpm --filter './packages/*' --if-present format:check && pnpm --filter './apps/*' --if-present format:check",
    "lint": "pnpm --filter './packages/*' --if-present lint && pnpm --filter './apps/*' --if-present lint",
    "typecheck": "pnpm --filter './packages/*' build && pnpm --filter './packages/*' typecheck && pnpm --filter './apps/*' typecheck",
    "test": "pnpm --filter './packages/*' --if-present test && pnpm --filter './apps/*' --if-present test",
    "benchmarks": "pnpm --filter @pmndrs/text-benchmarks dev",
    "test:types": "pnpm --filter @pmndrs/text test:types"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.15.1"
}
