{
  "name": "pmndrs-text-workspace",
  "private": true,
  "license": "MIT",
  "author": "Justin Walsh (https://github.com/thejustinwalsh)",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "check": "pnpm claude:sync:typecheck && pnpm claude:sync:test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check",
    "claude:sync": "node .claude/hooks/sync-agent-config.ts --verbose",
    "claude:sync:test": "node --test .claude/hooks/sync-agent-config.test.ts",
    "claude:sync:typecheck": "tsc -p .claude/tsconfig.json",
    "docs:digest": "ruby .agents/skills/open-knowledge-format/scripts/generate_package_digests.rb .",
    "docs:check": "ruby .agents/skills/open-knowledge-format/scripts/validate_okf.rb docs --workspace-root .",
    "format:check": "oxfmt --check .claude/hooks .claude/settings.json .claude/tsconfig.json package.json docs/log.md && pnpm --filter './packages/*' --if-present format:check && pnpm --filter './apps/*' --if-present format:check",
    "lint": "pnpm --filter './packages/*' --if-present lint && pnpm --filter './apps/*' --if-present lint",
    "typecheck": "pnpm --filter './packages/*' build && pnpm --filter './packages/*' typecheck && pnpm --filter './apps/*' typecheck",
    "test": "pnpm --filter './packages/*' --if-present test && pnpm --filter './apps/*' --if-present test",
    "benchmarks": "pnpm --filter @pmndrs/text-benchmarks dev",
    "benchmarks:check": "pnpm --filter @pmndrs/text-benchmarks check",
    "benchmarks:test:live": "pnpm --filter @pmndrs/text-benchmarks test:live",
    "benchmarks:test:external-raster-proof": "pnpm --filter @pmndrs/text-benchmarks test:external-raster-proof",
    "benchmarks:test:presentation-demo": "pnpm --filter @pmndrs/text-benchmarks test:presentation-demo",
    "benchmarks:test:presentation-controls": "pnpm --filter @pmndrs/text-benchmarks test:presentation-controls",
    "benchmarks:test:raster-technique-compare": "pnpm --filter @pmndrs/text-benchmarks test:raster-technique-compare",
    "benchmarks:profile:paragraph-layout": "pnpm --filter @pmndrs/text-benchmarks profile:paragraph-layout",
    "benchmarks:profile:paragraph-font-size:bitmap": "pnpm --filter @pmndrs/text-benchmarks profile:paragraph-font-size:bitmap",
    "benchmarks:profile:paragraph-font-size:bitmap:cpu": "pnpm --filter @pmndrs/text-benchmarks profile:paragraph-font-size:bitmap:cpu",
    "benchmarks:profile:inspect:paragraph-font-size:bitmap": "pnpm --filter @pmndrs/text-benchmarks profile:inspect:paragraph-font-size:bitmap",
    "benchmarks:profile:icon-grid:gc": "pnpm --filter @pmndrs/text-benchmarks profile:icon-grid:gc",
    "benchmarks:profile:presentation-sweep": "pnpm --filter @pmndrs/text-benchmarks profile:presentation-sweep",
    "benchmarks:generate:japanese-showcase-subset": "pnpm --filter @pmndrs/text-benchmarks generate:japanese-showcase-subset",
    "test:types": "pnpm --filter @pmndrs/text test:types"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "0.35.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.15.1"
}
