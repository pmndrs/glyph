{
  "name": "@pmndrs/glyph-hero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bake": "node ./scripts/bake.mts",
    "bake:check": "node ./scripts/bake.mts --check",
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm bake:check && pnpm build",
    "dev": "vite",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pmndrs/glyph": "workspace:*",
    "@react-three/drei": "11.0.0-alpha.7",
    "@react-three/fiber": "catalog:renderer",
    "box3d.js": "0.1.1",
    "opentype.js": "2.0.0",
    "react": "catalog:renderer",
    "react-dom": "catalog:renderer",
    "three": "catalog:renderer"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  }
}
