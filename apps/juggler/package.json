{
  "name": "@pmndrs/glyph-juggler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bake": "pnpm glyph bake --input ../../benches/fixtures/fonts/inter-v4.1/Inter-Regular.ttf --output ./assets/inter-latin.font.glb --unicodes U+0020-007E --msdf",
    "bake:check": "pnpm bake --check",
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm bake:check && pnpm build",
    "dev": "vite --port ${PORT:-5173}",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pmndrs/glyph": "workspace:*",
    "@react-three/fiber": "catalog:renderer",
    "koota": "0.6.6-canary.63c1187",
    "math": "0.1.0",
    "react": "catalog:renderer",
    "react-dom": "catalog:renderer",
    "three": "catalog:renderer"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  }
}
