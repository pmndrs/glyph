{
  "name": "@pmndrs/text-benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm size && vite build && node ./scripts/check-font-notices.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit && pnpm build",
    "admit:live": "node ./scripts/run-admission.mts",
    "capture:browser-reference": "node ./scripts/capture-browser-reference.mts",
    "capture:icon-grid-retained-evidence": "node ./scripts/capture-icon-grid-retained-evidence.mts",
    "capture:bake-host-baseline": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/capture-bake-host-baseline.mts",
    "capture:advanced-shaping-performance": "node ./scripts/capture-advanced-shaping-performance.mts",
    "capture:raster-performance": "node ./scripts/capture-raster-performance.mts",
    "capture:slug-performance-matrix": "node ./scripts/capture-slug-performance-matrix.mts",
    "capture:slug-external-render-parity": "node ./scripts/capture-slug-external-render-parity.mts",
    "capture:slug-quality-matrix": "node ./scripts/capture-slug-quality-matrix.mts",
    "capture:slug-role-scenes": "node ./scripts/capture-slug-role-scenes.mts",
    "capture:slug-fixed32-quality": "node ./scripts/capture-slug-fixed32-quality.mts",
    "capture:slug-fixed32-performance": "node ./scripts/capture-slug-fixed32-performance.mts",
    "capture:slug-adaptive32-quality": "node ./scripts/capture-slug-adaptive32-quality.mts",
    "capture:slug-adaptive32-performance": "node ./scripts/capture-slug-adaptive32-performance.mts",
    "capture:mtsdf-simd": "node ./scripts/capture-mtsdf-simd.mts",
    "check:autoresearch-baseline": "node ./scripts/generate-autoresearch-baseline.mts --check",
    "check:size": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/measure-package-sizes.mts --check",
    "check:paragraph-bidi-contract": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-paragraph-bidi-contract.mts --check",
    "check:paragraph-cjk-contract": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-paragraph-cjk-contract.mts --check",
    "check:mtsdf-render-fixture": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-mtsdf-render-fixture.mts --check",
    "check:slug-render-fixture": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-slug-render-fixture.mts --check",
    "check:japanese-showcase-subset": "node ./scripts/provision-harfbuzz.mts && node ./scripts/generate-japanese-showcase-subset.mts --check",
    "check:showcase-rasters": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-showcase-raster-fixtures.mts --check",
    "dev": "pnpm --filter @pmndrs/text-font-baker build && vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:harfbuzz-oracle": "node ./scripts/generate-harfbuzz-oracle.mts",
    "generate:autoresearch-baseline": "node ./scripts/generate-autoresearch-baseline.mts",
    "generate:paragraph-bidi-contract": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-paragraph-bidi-contract.mts && oxfmt fixtures/contracts/paragraph-bidi-layout-v0.json",
    "generate:paragraph-cjk-contract": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-paragraph-cjk-contract.mts && oxfmt fixtures/contracts/paragraph-cjk-layout-v0.json",
    "generate:mtsdf-render-fixture": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-mtsdf-render-fixture.mts",
    "generate:slug-render-fixture": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-slug-render-fixture.mts",
    "generate:slug-fixed32-experiment": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-slug-fixed32-experiment.mts",
    "generate:slug-adaptive-experiment": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-slug-fixed32-experiment.mts --experiment=adaptive",
    "generate:slug-adaptive32-experiment": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-slug-fixed32-experiment.mts --experiment=adaptive32",
    "generate:japanese-showcase-subset": "node ./scripts/generate-japanese-showcase-subset.mts",
    "generate:showcase-rasters": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/generate-showcase-raster-fixtures.mts",
    "lint": "oxlint --deny-warnings .",
    "size": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/measure-package-sizes.mts",
    "sync:amiri-fixture": "node ./scripts/sync-amiri-fixture.mts",
    "sync:dancing-script-fixture": "node ./scripts/sync-dancing-script-fixture.mts",
    "sync:cjk-fixture": "node ./scripts/sync-cjk-fixture.mts",
    "sync:devanagari-fixture": "node ./scripts/sync-devanagari-fixture.mts",
    "sync:japanese-showcase-fixture": "node ./scripts/sync-japanese-showcase-fixture.mts",
    "sync:source-serif-fixture": "node ./scripts/sync-source-serif-fixture.mts",
    "sync:font-awesome-icons": "node ./scripts/sync-font-awesome-icons.mts",
    "provision:harfbuzz": "node ./scripts/provision-harfbuzz.mts",
    "profile:paragraph-layout": "vitexec --gpu --path '/presentation?mode=benchmark&technique=mtsdf&backend=webgpu&delivery=baked&dpr=2&font=inter&workload=paragraph-stress' ./vitexec/paragraph-layout-profile.probe.ts",
    "profile:paragraph-font-size:bitmap": "vitexec --gpu --path '/presentation?mode=benchmark&technique=bitmap&backend=webgpu&delivery=baked&dpr=2&font=inter&workload=paragraph-stress&profileControl=font-size' ./vitexec/paragraph-layout-profile.probe.ts",
    "profile:paragraph-font-size:bitmap:cpu": "vitexec --gpu --cpu-profile ./.cache/paragraph-font-size-bitmap.cpuprofile --path '/presentation?mode=benchmark&technique=bitmap&backend=webgpu&delivery=baked&dpr=2&font=inter&workload=paragraph-stress&profileControl=font-size' ./vitexec/paragraph-layout-profile.probe.ts",
    "profile:inspect:paragraph-font-size:bitmap": "node ./scripts/summarize-cpu-profile.mts ./.cache/paragraph-font-size-bitmap.cpuprofile",
    "profile:presentation-sweep": "vitexec --gpu --path '/presentation?mode=benchmark&technique=bitmap&backend=webgpu&delivery=baked&dpr=2&font=inter&workload=benchmark-ipsum' ./vitexec/presentation-framerate-sweep.probe.ts",
    "test": "pnpm check:size && pnpm check:autoresearch-baseline && pnpm check:japanese-showcase-subset && pnpm check:paragraph-bidi-contract && pnpm check:paragraph-cjk-contract && pnpm test:unit && pnpm test:headless && pnpm test:packed",
    "test:headless": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/run-headless.mts --suite conformance --dpr 1 --samples 3 --warmup 1 --port 5181",
    "test:packed": "pnpm --filter @pmndrs/text build && pnpm --filter @pmndrs/text-font-baker build && node ./scripts/run-packed-consumer.mts",
    "test:live": "node ./scripts/run-live-probe.mts",
    "test:presentation-workloads": "node ./scripts/run-presentation-workload-probe.mts",
    "test:presentation-controls": "vitexec --gpu --path '/presentation?mode=benchmark&technique=mtsdf&backend=webgpu&delivery=baked&dpr=2&font=inter&workload=icon-grid' ./vitexec/presentation-controls.probe.ts",
    "test:raster-technique-compare": "pnpm test:raster-technique-compare:webgpu && pnpm test:raster-technique-compare:webgl",
    "test:raster-technique-compare:webgl": "vitexec --gpu --path '/?mode=conformance&technique=mtsdf&backend=webgl2&delivery=baked&dpr=1&font=inter&workload=mtsdf-slug-compare' ./vitexec/raster-technique-compare.probe.ts",
    "test:raster-technique-compare:webgpu": "vitexec --gpu --path '/?mode=conformance&technique=mtsdf&backend=webgpu&delivery=baked&dpr=1&font=inter&workload=mtsdf-slug-compare' ./vitexec/raster-technique-compare.probe.ts",
    "test:unit": "vitest run && pnpm test:scripts",
    "test:scripts": "node --test ./scripts/support/project-chromium.test.mts",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @pmndrs/text-font-baker build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@pmndrs/text": "workspace:*",
    "@pmndrs/text-font-baker": "workspace:*",
    "@react-three/fiber": "10.0.0-alpha.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "koota": "0.6.6",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.0",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "tw-animate-css": "1.4.0",
    "unicode-segmenter": "0.15.0",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.2.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "playwright": "1.61.1",
    "tailwindcss": "4.2.1",
    "vite": "8.1.5",
    "vitest": "4.1.0",
    "vitexec": "0.1.17"
  }
}
