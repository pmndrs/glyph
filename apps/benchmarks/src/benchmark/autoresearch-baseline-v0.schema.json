{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "pmndrs/glyph autoresearch baseline V0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseCommit", "campaign", "environment", "evidence"],
  "properties": {
    "schemaVersion": { "enum": [0] },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "enum": ["disabled"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "rust"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 },
        "rust": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "bytes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
