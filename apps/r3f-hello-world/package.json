{
  "name": "@pmndrs/glyph-r3f-hello-world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bake": "pnpm bake:inter && pnpm bake:icons",
    "bake:inter": "pnpm exec glyph bake --input ../benchmarks/fixtures/fonts/inter-v4.1/Inter-Regular.ttf --output ./assets/inter-latin.font.glb --unicodes U+0020-007E --bitmap 32 --msdf --slug",
    "bake:icons": "pnpm exec glyph bake --input ../benchmarks/fixtures/fonts/font-awesome-free-6.7.2/fa-solid-900.ttf --output ./assets/font-awesome-world.font.glb --unicodes U+E47B,U+F0AC,U+F57C,U+F57D,U+F57E,U+F7A2 --bitmap 32 --msdf --slug",
    "bake:check": "pnpm bake:check:inter && pnpm bake:check:icons",
    "bake:check:inter": "pnpm bake:inter --check",
    "bake:check:icons": "pnpm bake:icons --check",
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm bake:check && pnpm build && pnpm live:check",
    "dev": "vite",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "live:check": "vitexec --gpu ./scripts/live-check.probe.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pmndrs/glyph": "workspace:*",
    "@react-three/fiber": "10.0.0-alpha.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.35.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitexec": "0.1.17"
  }
}
