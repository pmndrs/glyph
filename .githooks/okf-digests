#!/bin/sh
# Keep OKF source digests current at commit time — automatically and silently.
#
# Every .agents/docs/packages/<name>.md pins a source_digest over its package tree.
# This hook recomputes the digests for whatever packages a commit stages,
# rewrites the pins, and stages the result. It computes from the STAGED tree
# (materialized via checkout-index), so unstaged edits never leak into a pin,
# and it NEVER blocks a commit: anything it cannot do becomes a warning and
# CI's knowledge-base gate remains the enforcement.
#
# Ships versioned in .gitconfig; opt in once per clone:
#   git config set include.path ../.gitconfig
cd "$(git rev-parse --show-toplevel)" || exit 0

run_ruby() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- ruby "$@"
  else
    ruby "$@"
  fi
}

# Stdlib-pure scripts: any Ruby >= 3.1, however installed. Missing or old
# Ruby downgrades the hook to a warning, never a blocked commit.
if ! run_ruby -e 'exit(Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.1") ? 0 : 1)' 2>/dev/null; then
  echo "okf-digests: Ruby >= 3.1 not found; digest pins left to CI." >&2
  exit 0
fi

staged=$(git diff --cached --name-only)
[ -n "$staged" ] || exit 0

affected=""
for root in apps/benchmarks apps/r3f-hello-world packages/glyph packages/glyph-example-raster; do
  if printf '%s\n' "$staged" | grep -q "^$root/"; then
    affected="$affected $root"
  fi
done
if [ -z "$affected" ]; then
  if printf '%s\n' "$staged" | grep -q "^.agents/docs/"; then
    run_ruby .agents/skills/open-knowledge-format/scripts/validate_okf.rb .agents/docs --workspace-root . ||
      echo "okf-digests: validation reported issues above (commit not blocked; CI enforces)." >&2
  fi
  exit 0
fi

# Materialize the staged content of the affected packages and hash THAT.
tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
for root in $affected; do
  git ls-files -z -- "$root" | git checkout-index --prefix="$tmp/" -z --stdin 2>/dev/null || true
done
digests=$(run_ruby .agents/skills/open-knowledge-format/scripts/generate_package_digests.rb "$tmp" 2>/dev/null) || {
  echo "okf-digests: digest generation failed; pins left to CI." >&2
  exit 0
}

for root in $affected; do
  doc=".agents/docs/packages/$(basename "$root").md"
  [ -f "$doc" ] || continue
  digest=$(printf '%s\n' "$digests" | awk -F'\t' -v r="$root" '$3 == r { print $2 }')
  [ -n "$digest" ] || continue
  if ! grep -q "source_digest: '$digest'" "$doc"; then
    perl -pi -e "s/source_digest: 'sha256:[0-9a-f]+'/source_digest: '$digest'/" "$doc"
    git add "$doc"
    echo "okf-digests: re-pinned $doc"
  fi
done

run_ruby .agents/skills/open-knowledge-format/scripts/validate_okf.rb .agents/docs --workspace-root . ||
  echo "okf-digests: validation reported issues above (commit not blocked; CI enforces)." >&2
exit 0
