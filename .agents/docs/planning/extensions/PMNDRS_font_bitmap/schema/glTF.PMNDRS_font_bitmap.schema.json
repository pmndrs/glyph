{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "PMNDRS_font_bitmap glTF Document Extension",
  "type": "object",
  "allOf": [
    {
      "$ref": "glTFProperty.schema.json"
    }
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        0
      ]
    },
    "rasterKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "fingerprint": {
      "description": "Single value this raster and its core font compare to decide they belong together.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "coverage": {
      "$ref": "#/definitions/rasterCoverage"
    },
    "coverageBufferView": {
      "type": "integer",
      "minimum": 0
    },
    "strikes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "ppemX": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1022
          },
          "ppemY": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1022
          },
          "planeUnitsPerEm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32767
          },
          "recordBufferView": {
            "type": "integer",
            "minimum": 0
          },
          "recordStride": {
            "type": "integer",
            "enum": [
              20
            ]
          },
          "pages": {
            "$ref": "../../schema/texturePages.PMNDRS_font.schema.json"
          }
        },
        "required": [
          "ppemX",
          "ppemY",
          "planeUnitsPerEm",
          "recordBufferView",
          "recordStride",
          "pages"
        ]
      }
    }
  },
  "required": [
    "version",
    "rasterKey",
    "fingerprint",
    "strikes"
  ],
  "definitions": {
    "rasterCoverage": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "unicodeRanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1114111
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1114111
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "glyphIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65535,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
