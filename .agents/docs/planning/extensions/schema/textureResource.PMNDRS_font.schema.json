{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "PMNDRS font texture resource",
  "type": "object",
  "properties": {
    "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "height": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "mipLevelCount": { "type": "integer", "minimum": 1 },
    "colorSpace": { "type": "string", "enum": ["linear", "srgb"] },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": { "$ref": "resourceSource.PMNDRS_font.schema.json" },
          "container": { "type": "string", "enum": ["ktx2"] },
          "gpuFormat": {
            "type": "string",
            "enum": [
              "r8unorm",
              "rgba8unorm",
              "rgba16float",
              "r16uint",
              "r32uint",
              "bc4-r-unorm",
              "bc7-rgba-unorm",
              "eac-r11unorm",
              "etc2-rgba8unorm",
              "astc-4x4-unorm"
            ]
          },
          "requiredFeature": {
            "type": "string",
            "enum": [
              "texture-compression-bc",
              "texture-compression-etc2",
              "texture-compression-astc"
            ]
          },
          "quality": { "type": "string", "enum": ["lossless", "quality-gated"] }
        },
        "required": ["source", "container", "gpuFormat", "quality"]
      }
    }
  },
  "required": ["width", "height", "mipLevelCount", "colorSpace", "variants"]
}
