    "texts": [
      {
        "role": "primary",
        "sourceText": "The pull of a justified column is older than the press that made it common. A page holds its measure, both edges true, while every line negotiates its own interior: word spaces narrow only inside declared bounds and widen to settle the remaining difference.",
