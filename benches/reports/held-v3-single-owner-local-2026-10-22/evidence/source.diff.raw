+/// Admit one rope range only when the already validated dirty frontier owns every
+/// source row and no positioned owner retains a clean source interval.
+fn planner_full_frontier_source_range(planner: &PlannerState) -> Option<core::ops::Range<usize>> {
+    let order = planner.active_order();
+    if planner.lifecycle_changed
+        || order.is_empty()
+        || planner.order_sort_scratch.len() != order.len()
+    {
+        return None;
+    }
+    let mut previous = None;
+    for (index, &(order_index, id)) in planner.order_sort_scratch.iter().enumerate() {
+        if usize::try_from(order_index).ok()? != index || order[index].id != id {
+            return None;
+        }
+        let paragraph = planner.paragraph(id)?;
+        let range = paragraph.gather_range?;
+        let positioned = paragraph.state.positioned.active();
+        let source_count = positioned.glyphs().len();
+        if !range.follows(previous)
+            || range.source_count() != source_count
+            || !positioned.decorations().is_empty()
+            || !paragraph
+                .state
+                .positioned
+                .committed()
+                .decorations()
+                .is_empty()
+            || positioned
+                .unpublished_source_intervals()
+                .is_some_and(|intervals| {
+                    !(source_count == 0 && intervals.is_empty()
+                        || intervals.len() == 1
+                            && intervals[0].start == 0
+                            && intervals[0].end == source_count)
+                })
+        {
+            return None;
+        }
+        previous = Some(range);
+    }
+    let end = previous?.source_end();
+    (end > 0 && Some(end) == planner.gathered_source_count).then_some(0..end)
+}
