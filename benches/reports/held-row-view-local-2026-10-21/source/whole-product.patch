+/// Source-totality and old/new ordinal geometry are proved without touching the gather cache.
+/// This deliberately overapproximates all registered binding domains for this exact codec key.
+fn direct_candidate_admissible(
+    planner: &PlannerState,
+    previous: &CodecGatherWorkspace,
+    codec: &ValidatedCodec,
+    capability_set: CapabilitySetId,
+    font_bindings: &[RegisteredFontBinding],
+) -> bool {
+    if planner.lifecycle_changed
+        || planner.order_sort_scratch.len() != planner.active_order().len()
+        || font_bindings.is_empty()
+    {
+        return false;
+    }
+    let mut source = 0usize;
+    let mut record = 0usize;
+    for (order_index, ordered) in planner.active_order().iter().enumerate() {
+        if planner
+            .order_sort_scratch
+            .get(order_index)
+            .is_none_or(|entry| {
+                usize::try_from(entry.0).ok() != Some(order_index) || entry.1 != ordered.id
+            })
+        {
+            return false;
+        }
+        let Some(paragraph) = planner.paragraph(ordered.id) else {
+            return false;
+        };
+        let positioned = paragraph.state.positioned.active();
+        let Some(range) = paragraph.gather_range else {
+            return false;
+        };
+        // The direct candidate visits every source. Admit only when the original packed
+        // retained route would visit every source too; narrow island work stays packed.
+        let owner_scanned = paragraph.positioned_changed
+            || paragraph.preparation_changed_since_publication
+            || planner
+                .pending_preparation_ids
+                .binary_search(&ordered.id)
+                .is_ok();
+        if !owner_scanned {
+            return false;
+        }
+        if (paragraph.positioned_changed || paragraph.preparation_changed_since_publication)
+            && let Some(intervals) = positioned.unpublished_source_intervals()
+            && (intervals.len() != 1 || intervals[0] != (0..positioned.glyphs().len()))
+        {
+            return false;
+        }
+        if paragraph.pending_remove
+            || !positioned.decorations().is_empty()
+            || range.source_start() != source
+            || range.record_start() != record
+            || range.source_count() != positioned.glyphs().len()
+            || positioned.semantic_change_masks().len() != positioned.glyphs().len()
+        {
+            return false;
+        }
+        source = range.source_end();
+        record = range.record_end();
+        let semantic_f32 = positioned.semantic_f32();
+        let semantic_u32 = positioned.semantic_u32();
+        let input = LayoutPlanInput {
+            transform_id: ordered.id,
+            glyphs: positioned.glyphs(),
+            semantic_glyphs: positioned.semantic_glyphs(),
+            placement_translations: positioned.placement_translations(),
+            semantic_change_masks: positioned.semantic_change_masks(),
+            semantic_f32: &semantic_f32,
+            semantic_u32: &semantic_u32,
+        };
+        if !direct_owner_sources_total(input, codec, capability_set, font_bindings) {
+            return false;
+        }
+    }
+    source == previous.source_count() && record == previous.view().plan_input().glyphs.len()
+}
+
+fn direct_owner_sources_total(
+    input: LayoutPlanInput<'_>,
+    codec: &ValidatedCodec,
+    capability_set: CapabilitySetId,
+    font_bindings: &[RegisteredFontBinding],
+) -> bool {
+    font_bindings.iter().all(|registered| {
+        let binding = &registered.binding;
+        codec
+            .program(
+                capability_set,
+                binding.technique(),
+                binding.program_variant(),
+            )
+            .is_some_and(|program| {
+                direct_binding_sources_total(binding, program)
+                    && direct_semantic_sources_total(input, program)
+            })
+    })
+}
+
+fn metadata_declared_sources_total(
+    planner: &PlannerState,
+    codec: &ValidatedCodec,
+    capability_set: CapabilitySetId,
+    font_bindings: &[RegisteredFontBinding],
+) -> bool {
+    planner.active_order().iter().all(|ordered| {
+        let Some(paragraph) = planner.paragraph(ordered.id) else {
+            return false;
+        };
+        let positioned = paragraph.state.positioned.active();
+        let semantic_f32 = positioned.semantic_f32();
+        let semantic_u32 = positioned.semantic_u32();
+        direct_owner_sources_total(
+            LayoutPlanInput {
+                transform_id: ordered.id,
+                glyphs: positioned.glyphs(),
+                semantic_glyphs: positioned.semantic_glyphs(),
+                placement_translations: positioned.placement_translations(),
+                semantic_change_masks: positioned.semantic_change_masks(),
+                semantic_f32: &semantic_f32,
+                semantic_u32: &semantic_u32,
+            },
+            codec,
+            capability_set,
+            font_bindings,
+        )
+    })
+}
+
+fn build_direct_candidate(
+    candidate: &mut CodecGatherWorkspace,
+    previous: &CodecGatherWorkspace,
+    planner: &PlannerState,
+    codec: &ValidatedCodec,
+    capability_set: CapabilitySetId,
+    font_bindings: &[RegisteredFontBinding],
+) -> bool {
+    let record_count = previous.view().plan_input().glyphs.len();
+    if candidate.begin_direct(record_count).is_err() {
+        return false;
+    }
+    for ordered in planner.active_order() {
+        #[cfg(test)]
+        super::work_attribution::record(|work| work.gather_paragraph_visits += 1);
+        let Ok(paragraph_index) = planner
+            .paragraphs
+            .binary_search_by_key(&ordered.id, |paragraph| paragraph.id)
+        else {
+            return false;
+        };
+        let paragraph = &planner.paragraphs[paragraph_index];
+        let Some(old_range) = paragraph.gather_range else {
+            return false;
+        };
+        let positioned = paragraph.state.positioned.active();
+        let semantic_f32 = positioned.semantic_f32();
+        let semantic_u32 = positioned.semantic_u32();
+        let masks =
+            if paragraph.positioned_changed || paragraph.preparation_changed_since_publication {
+                positioned.semantic_change_masks()
+            } else {
+                &[][..]
+            };
+        let input = LayoutPlanInput {
+            transform_id: ordered.id,
+            glyphs: positioned.glyphs(),
+            semantic_glyphs: positioned.semantic_glyphs(),
+            placement_translations: positioned.placement_translations(),
+            semantic_change_masks: masks,
+            semantic_f32: &semantic_f32,
+            semantic_u32: &semantic_u32,
+        };
+        let Ok(paragraph_index) = u32::try_from(paragraph_index) else {
+            return false;
+        };
+        match candidate.append_direct_from(
+            previous,
+            old_range,
+            paragraph_index,
+            codec,
+            capability_set,
+            input,
+            |handle| {
+                font_bindings
+                    .iter()
+                    .enumerate()
+                    .find(|(_, registered)| registered.handle == handle)
+                    .and_then(|(index, registered)| {
+                        u32::try_from(index)
+                            .ok()
+                            .map(|index| (index, &registered.binding))
+                    })
+            },
+        ) {
+            Ok(true) => {}
+            Ok(false) | Err(_) => return false,
+        }
+    }
+    candidate.source_count() == previous.source_count()
+        && candidate.direct_locators().len() == record_count
+        && candidate.view().plan_input().glyphs.len() == record_count
+}
