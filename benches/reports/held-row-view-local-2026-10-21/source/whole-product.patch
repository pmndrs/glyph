+/// Conservative eligibility only. A false result leaves the unchanged packed path responsible
+/// for both acceptance and the exact public error order.
+pub(crate) fn direct_semantic_sources_total(
+    input: LayoutPlanInput<'_>,
+    program: &ProgramDescriptor,
+) -> bool {
+    let rows = input.glyphs.len();
+    if !input.semantic_change_masks.is_empty() && input.semantic_change_masks.len() != rows {
+        return false;
+    }
+    for source in &program.inputs[..usize::from(program.f32_input_count)] {
+        if source.scope != InputScope::Semantic {
+            continue;
+        }
+        let field = source.field;
+        if !known_semantic_f32(field) {
+            return false;
+        }
+        if matches!(
+            field,
+            SEMANTIC_F32_INLINE_ORIGIN | SEMANTIC_F32_BLOCK_ORIGIN | SEMANTIC_F32_INVERSE_FONT_SIZE
+        ) {
+            continue;
+        }
+        if matches!(
+            field,
+            SEMANTIC_F32_FOREGROUND_RED
+                | SEMANTIC_F32_FOREGROUND_GREEN
+                | SEMANTIC_F32_FOREGROUND_BLUE
+                | SEMANTIC_F32_FOREGROUND_ALPHA
+        ) {
+            if input
+                .semantic_u32
+                .get(usize::from(SEMANTIC_U32_FOREGROUND_RGBA))
+                .is_none_or(|values| values.len() != rows)
+            {
+                return false;
+            }
+            continue;
+        }
+        let optional = matches!(
+            field,
+            SEMANTIC_F32_OUTLINE_WIDTH_EM
+                | SEMANTIC_F32_SHADOW_OFFSET_X_EM
+                | SEMANTIC_F32_SHADOW_OFFSET_Y_EM
+        );
+        if input
+            .semantic_f32
+            .get(usize::from(field))
+            .is_none_or(|values| values.len() != rows && !(optional && values.is_empty()))
+        {
+            return false;
+        }
+    }
+    for source in &program.inputs[usize::from(program.f32_input_count)..] {
+        if source.scope != InputScope::Semantic || source.field == SEMANTIC_U32_PLACEMENT_SLOT {
+            continue;
+        }
+        let optional = matches!(
+            source.field,
+            SEMANTIC_U32_OUTLINE_RGBA | SEMANTIC_U32_SHADOW_RGBA
+        );
+        if input
+            .semantic_u32
+            .get(usize::from(source.field))
+            .is_none_or(|values| values.len() != rows && !(optional && values.is_empty()))
+        {
+            return false;
+        }
+    }
+    true
+}
