+pub(crate) fn direct_binding_sources_total(
+    binding: &FontRenderBinding,
+    program: &ProgramDescriptor,
+) -> bool {
+    for (index, source) in program.inputs.iter().enumerate() {
+        let float = index < usize::from(program.f32_input_count);
+        let count = match (source.scope, float) {
+            (InputScope::Semantic, _) => continue,
+            (InputScope::Glyph, true) => binding.glyph_f32().field_count(),
+            (InputScope::Glyph, false) => binding.glyph_u32().field_count(),
+            (InputScope::Strike, true) => binding.strike_f32().field_count(),
+            (InputScope::Strike, false) => binding.strike_u32().field_count(),
+            (InputScope::Resource, true) => binding.resource_f32().field_count(),
+            (InputScope::Resource, false) => binding.resource_u32().field_count(),
+        };
+        if source.field >= count {
+            return false;
+        }
+    }
+    true
+}
