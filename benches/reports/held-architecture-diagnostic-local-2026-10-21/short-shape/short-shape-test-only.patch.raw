diff --git a/packages/glyph/rust/shaper/src/engine/work_attribution.rs b/packages/glyph/rust/shaper/src/engine/work_attribution.rs
index 9e00ba9a..6a20a626 100644
--- a/packages/glyph/rust/shaper/src/engine/work_attribution.rs
+++ b/packages/glyph/rust/shaper/src/engine/work_attribution.rs
@@ -1,5 +1,58 @@
 //! Test-only work counts. These observe existing owners; they are not timers or a second executor.
 
+/// Temporary, opt-in diagnostic for the authenticated short-label shape boundary replay.
+/// The owner enables it for one measure, takes it before the next event, and leaves it off
+/// during initialization and publication. Remove after the architecture decision.
+pub(crate) mod short_shape_probe {
+    use core::cell::RefCell;
+    use serde_json::{Value, json};
+
+    std::thread_local! {
+        static ROW: RefCell<Option<Value>> = const { RefCell::new(None) };
+    }
+
+    pub(crate) fn begin(identity: Value) {
+        ROW.with(|row| {
+            let mut row = row.borrow_mut();
+            assert!(row.is_none(), "stale shape observation");
+            *row = Some(json!({"identity": identity, "attempts": []}));
+        });
+    }
+
+    pub(crate) fn record(key: &str, value: Value) {
+        ROW.with(|row| {
+            if let Some(row) = row.borrow_mut().as_mut() {
+                row[key] = value;
+            }
+        });
+    }
+
+    pub(crate) fn attempt(value: Value) {
+        ROW.with(|row| {
+            if let Some(row) = row.borrow_mut().as_mut() {
+                row["attempts"].as_array_mut().unwrap().push(value);
+            }
+        });
+    }
+
+    pub(crate) fn enabled() -> bool {
+        ROW.with(|row| row.borrow().is_some())
+    }
+
+    pub(crate) fn attempt_ordinal() -> u64 {
+        ROW.with(|row| {
+            row.borrow()
+                .as_ref()
+                .and_then(|row| row["attemptOrdinal"].as_u64())
+                .unwrap_or(0)
+        })
+    }
+
+    pub(crate) fn take() -> Value {
+        ROW.with(|row| row.borrow_mut().take().expect("missing shape observation"))
+    }
+}
+
 use core::cell::Cell;
 
 #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
