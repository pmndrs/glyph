+#[cfg(test)]
+fn short_probe_window(window: ShapeWindow) -> serde_json::Value {
+    serde_json::json!({
+        "oldStart": window.old_start, "oldEnd": window.old_end,
+        "newStart": window.new_start, "newEnd": window.new_end,
+        "probeEnd": window.probe_end,
+        "oldGlyphStart": window.old_glyph_start, "oldGlyphEnd": window.old_glyph_end,
+    })
+}
+
+#[cfg(test)]
+fn short_probe_boundary(
+    shape: &ShapeArena,
+    boundary: u32,
+    start: usize,
+    end: usize,
+) -> serde_json::Value {
+    let glyph = (start..end).find(|&index| shape.clusters[index] == boundary);
+    let Some(glyph) = glyph else {
+        return serde_json::json!({"offset": boundary, "state": "missing", "safe": false});
+    };
+    let cluster = shape.clusters[glyph];
+    let mut first = glyph;
+    let mut last = glyph + 1;
+    while first > start && shape.clusters[first - 1] == cluster {
+        first -= 1;
+    }
+    while last < end && shape.clusters[last] == cluster {
+        last += 1;
+    }
+    let unsafe_bits = shape.glyph_flags[first..last]
+        .iter()
+        .fold(0_u16, |bits, flags| {
+            bits | (flags & GLYPH_FLAG_UNSAFE_TO_CONCAT)
+        });
+    serde_json::json!({"offset": boundary, "state": if unsafe_bits == 0 { "present-safe" } else { "present-unsafe" }, "safe": unsafe_bits == 0, "glyph": glyph, "cluster": cluster, "glyphStart": first, "glyphEnd": last, "unsafeBits": unsafe_bits})
+}
